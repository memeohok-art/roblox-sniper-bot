# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
# `TOKEN=` is accepted as an alias if that is what your secret store calls it.
DISCORD_TOKEN=
# TOKEN=

# Optional: a single server id. Commands sync instantly there instead of
# taking up to an hour to propagate as global commands.
GUILD_ID=

# --- Roblox ----------------------------------------------------------------
# The .ROBLOSECURITY value of the account that does the buying.
# Read the "Getting the cookie" section of README.md — treat it like a password.
ROBLOX_COOKIE=

# --- Behaviour -------------------------------------------------------------
# true = the bot logs what it would buy but never actually purchases anything.
# Start with true, confirm /snipe scan finds what you want, then flip to false.
DRY_RUN=true

# Minimum seconds between any two requests to Roblox. Lower = faster but far
# more likely to get 429s (and rate-limit bans). 1.2 is a safe floor.
REQUEST_GAP=1.2

# Gap for the hot lane (purchases + watch-list polls). This lane has its own
# clock, so purchases never queue behind catalog scans. 0.35 is already aggressive.
HOT_GAP=0.35

# How many purchase attempts may be in flight at once (fast mode, multiple items).
MAX_IN_FLIGHT=4

# Where scan state / history is persisted.
DATA_PATH=data/state.json

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
